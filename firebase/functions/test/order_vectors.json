 {
  "name": "iptal ve ikram toplamdan düşer",
  "steps": [
   {
    "op": "openOrder",
    "payload": {
     "orderId": "o1",
     "no": "A1",
     "businessDay": "2026-10-15",
     "type": "dine_in",
     "tableId": "t1",
     "tableName": "Masa 1"
    },
    "staffId": "s1",
    "at": "2026-10-15T12:00:00+03:00"
   },
   {
    "op": "addItems",
    "payload": {
     "orderId": "o1",
     "items": [
      {
       "lineId": "l1",
       "productId": "p-l1",
       "name": "Latte",
       "unitPrice": 9500,
       "qty": 1,
       "station": "bar",
       "options": [],
       "stampEligible": true
      },
      {
       "lineId": "l2",
       "productId": "p-l2",
       "name": "Latte",
       "unitPrice": 13000,
       "qty": 1,
       "station": "kitchen",
       "options": [],
       "stampEligible": true
      },
      {
       "lineId": "l3",
       "productId": "p-l3",
       "name": "Latte",
       "unitPrice": 2000,
       "qty": 1,
       "station": "bar",
       "options": [],
       "stampEligible": true
      }
     ]
    },
    "staffId": "s1",
    "at": "2026-10-15T12:00:00+03:00"
   },
   {
    "op": "sendItems",
    "payload": {
     "orderId": "o1",
     "lineIds": [
      "l1",
      "l2",
      "l3"
     ],
     "ticketIds": {
      "bar": "tk-bar",
      "kitchen": "tk-kit"
     }
    },
    "staffId": "s1",
    "at": "2026-10-15T12:00:00+03:00"
   },
   {
    "op": "voidItem",
    "payload": {
     "orderId": "o1",
     "lineId": "l2",
     "reason": "Müşteri vazgeçti",
     "approvedBy": "m1"
    },
    "staffId": "s1",
    "at": "2026-10-15T12:00:00+03:00"
   },
   {
    "op": "compItem",
    "payload": {
     "orderId": "o1",
     "lineId": "l3",
     "reason": "Bekleme telafisi"
    },
    "staffId": "s1",
    "at": "2026-10-15T12:00:00+03:00"
   }
  ],
  "expect": {
   "o1": {
    "subtotal": 9500,
    "total": 9500
   }
  },
  "expectLines": {
   "o1": [
    {
     "lineId": "l1",
     "state": "sent",
     "status": "active",
     "ticketId": "tk-bar"
    },
    {
     "lineId": "l2",
     "state": "sent",
     "status": "void",
     "ticketId": "tk-kit",
     "approvedBy": "m1"
    },
    {
     "lineId": "l3",
     "state": "sent",
     "status": "comp"
    }
   ]
  }
 },
