[
 {
  "name": "iskonto üst üste binmez (eski NexPOS hatası)",
  "steps": [
   {
    "op": "openOrder",
    "payload": {
     "orderId": "o1",
     "no": "A1",
     "businessDay": "2026-10-15",
     "type": "dine_in",
     "tableId": "t1",
     "tableName": "Masa 1"
    },
    "staffId": "s1",
    "at": "2026-10-15T12:00:00+03:00"
   },
   {
    "op": "addItems",
    "payload": {
     "orderId": "o1",
     "items": [
      {
       "lineId": "l1",
       "productId": "p-l1",
       "name": "Latte",
       "unitPrice": 9500,
       "qty": 2,
       "station": "bar",
       "options": [],
       "stampEligible": true
      }
     ]
    },
    "staffId": "s1",
    "at": "2026-10-15T12:00:00+03:00"
   },
   {
    "op": "setDiscount",
    "payload": {
     "orderId": "o1",
     "discount": {
      "type": "percent",
      "value": 10
     }
    },
    "staffId": "s1",
    "at": "2026-10-15T12:00:00+03:00"
   },
   {
    "op": "addItems",
    "payload": {
     "orderId": "o1",
     "items": [
      {
       "lineId": "l2",
       "productId": "p-l2",
       "name": "Latte",
       "unitPrice": 8000,
       "qty": 1,
       "station": "bar",
       "options": [],
       "stampEligible": true
      }
     ]
    },
    "staffId": "s1",
    "at": "2026-10-15T12:00:00+03:00"
   }
  ],
  "expect": {
   "o1": {
    "subtotal": 27000,
    "discountAmount": 2700,
    "total": 24300,
    "status": "open"
   }
  }
 },
