 {
  "name": "doğum günü: 3 gün önce",
  "fn": "isBirthdayWeek",
  "args": [
   "10-19",
   "2026-10-16"
  ],
  "expect": true
 },
 {
  "name": "doğum günü: 4 gün sonra değil",
  "fn": "isBirthdayWeek",
  "args": [
   "10-12",
   "2026-10-16"
  ],
  "expect": false
 },
 {
  "name": "doğum günü: yıl dönümü",
  "fn": "isBirthdayWeek",
  "args": [
   "12-30",
   "2027-01-02"
  ],
  "expect": true
 },
 {
  "name": "doğum günü: 29 Şubat artık olmayan yılda 28'i",
  "fn": "isBirthdayWeek",
  "args": [
   "02-29",
   "2027-03-03"
  ],
  "expect": true
 },
 {
  "name": "doğum günü: yok",
  "fn": "isBirthdayWeek",
  "args": [
   null,
   "2026-10-16"
  ],
  "expect": false
 },
 {
  "name": "gün ekle",
  "fn": "addDays",
  "args": [
   "2026-12-20",
   60
  ],
  "expect": "2027-02-18"
 },
