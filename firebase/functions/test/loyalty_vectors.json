  ],
  "expect": "5321234567"
 },
 {
  "name": "telefon: eksik hane",
  "fn": "normalizePhone",
  "args": [
   "532 123 45"
  ],
  "expect": null
 },
 {
  "name": "telefon: 1 ile başlayamaz",
  "fn": "normalizePhone",
  "args": [
   "1321234567"
  ],
  "expect": null
 },
 {
  "name": "telefon: maske",
  "fn": "maskPhone",
  "args": [
   "5321234567"
  ],
  "expect": "0532 *** ** 67"
