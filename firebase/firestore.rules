rules_version = '2';

// NexPOS Firestore güvenlik kuralları.
//
// Temel ilke: personel, PIN, yetki ve terminal kayıtları istemciden ASLA doğrudan
// yazılamaz. Bu işlemler yalnızca Cloud Functions (Admin SDK, kuralları atlar)
// üzerinden yapılır.
//
// Kimlikler (custom claim):
//   - Personel (panelden e-posta ile giriş): request.auth.token.role
//   - Terminal (kafedeki NexPOS): request.auth.token.terminal == true ve terminalId
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() ? request.auth.token.get('role', '') : '';
    }

    function isStaff() {
      return role() in ['owner', 'manager', 'cashier', 'waiter', 'courier', 'barista', 'kitchen'];
    }

    function isManagerPlus() {
      return role() in ['owner', 'manager'];
    }

    // İptal edilmiş terminalin token'ı süresi dolana kadar geçerli kalır; bu yüzden
    // her istekte terminal kaydı kontrol edilir.
    function terminalLive() {
      return signedIn()
        && request.auth.token.get('terminal', false) == true
        && exists(/databases/$(database)/documents/terminals/$(request.auth.token.terminalId))
        && get(/databases/$(database)/documents/terminals/$(request.auth.token.terminalId)).data.revoked == false;
    }

    // Kasa terminali (NexPOS)
    function isActiveTerminal() {
      return terminalLive() && request.auth.token.get('kds', false) == false;
    }

    // Mutfak / bar ekranı (5. ekran): yalnızca fişleri ve modül/genel ayarları okur.
    function isActiveKds() {
      return terminalLive() && request.auth.token.get('kds', false) == true;
    }

    // Personel listesi: terminal önbelleğe alır (giriş ekranındaki kartlar).
    match /staff/{staffId} {
      allow read: if isManagerPlus() || isActiveTerminal()
        || (signedIn() && request.auth.uid == staffId);
      allow write: if false;
    }

    // PIN özetleri: yalnızca terminal okur (çevrimdışı PIN doğrulama için).
    // Yönetici dahil hiçbir personel okuyamaz.
    match /staffPins/{staffId} {
      allow read: if isActiveTerminal();
      allow write: if false;
    }

    // Ayarlar: settings/permissions vb. Yazma yalnızca fonksiyonlardan.
    match /settings/{docId} {
      allow read: if isStaff() || isActiveTerminal() || (isActiveKds() && docId in ['modules', 'general']);
      allow write: if false;
    }

    // Terminal kendi kaydını okur (iptal edildi mi?); yöneticiler hepsini görür.
    // İptal edilmiş terminal de kendi kaydını okuyabilmeli ki kilitlendiğini anlasın.
    match /terminals/{terminalId} {
      allow read: if isManagerPlus()
        || (signedIn() && request.auth.token.get('terminalId', '') == terminalId);
      allow write: if false;
    }

    // Menü herkese açıktır (müşteri uygulaması giriş yapmadan da menüyü görür).
    // Yazma yalnızca fonksiyonlardan: saveProduct, bulkUpdatePrices, syncOps(setSoldOut)…
    match /categories/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /products/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /optionGroups/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Salon planı: masalar qrToken taşıdığı için herkese açık DEĞİLDİR. Müşterinin QR ile
    // masa doğrulaması 11. ekranda bir fonksiyon üzerinden yapılacak.
    match /areas/{id} {
      allow read: if isStaff() || isActiveTerminal();
      allow write: if false;
    }
    match /tables/{id} {
      allow read: if isStaff() || isActiveTerminal();
      allow write: if false;
    }

    // Siparişler, mutfak/bar fişleri ve ödemeler: yalnızca personel ve terminal okur;
    // yazma terminal kuyruğundan (syncOps) gelir.
    match /orders/{id} {
      allow read: if isStaff() || isActiveTerminal();
      allow write: if false;
    }
    match /kitchenTickets/{id} {
      allow read: if isStaff() || isActiveTerminal() || isActiveKds();
      allow write: if false;
    }
    match /payments/{id} {
      allow read: if isManagerPlus() || isActiveTerminal();
      allow write: if false;
    }
    // İadeler ve kasa oturumları (6. ekran): ödemelerle aynı okuma kuralı.
    match /refunds/{id} {
      allow read: if isManagerPlus() || isActiveTerminal();
      allow write: if false;
    }
    match /cashSessions/{id} {
      allow read: if isManagerPlus() || isActiveTerminal();
      allow write: if false;
    }

    // Müşteri ve sadakat (10. ekran): kasa üyeyi telefonla internetsiz tanımak için önbelleğe alır.
    // Yazma yalnızca fonksiyonlardan (kuyruk: customerCreate, ödeme kapanışı; panel: saveCustomer).
    match /customers/{id} {
      allow read: if isManagerPlus() || isActiveTerminal();
      allow write: if false;
    }
    match /rewards/{id} {
      allow read: if isManagerPlus() || isActiveTerminal();
      allow write: if false;
    }
    match /loyaltyEvents/{id} {
      allow read: if isManagerPlus();
      allow write: if false;
    }
    // Kampanyalar herkese açıktır (müşteri uygulaması gösterir); bildirimler yönetici ve terminal (panel geçmişi).
    match /campaigns/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /notifications/{id} {
      allow read: if isManagerPlus() || isActiveTerminal();
      allow write: if false;
    }
    // Telefon dizini ve QR token'ları: yalnızca fonksiyonlar
    match /customerPhones/{phone} {
      allow read, write: if false;
    }
    match /loyaltyTokens/{token} {
      allow read, write: if false;
    }

    // Günlük özet (7. ekran): yalnızca yönetici ve müdür okur (telefondan rapor için hazırlık).
    match /dailyStats/{day} {
      allow read: if isManagerPlus();
      allow write: if false;
    }

    // Stok (8. ekran): malzemeler personel ve terminal okur (birim maliyet dahil — kafede gizli değildir;
    // kâr raporu yetkiyle sınırlıdır). Hareketler yönetici/müdür ve terminal.
    match /ingredients/{id} {
      allow read: if isStaff() || isActiveTerminal();
      allow write: if false;
    }
    match /stockMovements/{id} {
      allow read: if isManagerPlus() || isActiveTerminal();
      allow write: if false;
    }

    // Tedarik (8b): yönetici/müdür ve terminal okur; yazma fonksiyonlardan.
    match /suppliers/{id} {
      allow read: if isManagerPlus() || isActiveTerminal();
      allow write: if false;
    }
    match /purchaseOrders/{id} {
      allow read: if isManagerPlus() || isActiveTerminal();
      allow write: if false;
    }
    match /purchaseReceipts/{id} {
      allow read: if isManagerPlus() || isActiveTerminal();
      allow write: if false;
    }
    match /supplierPayments/{id} {
      allow read: if isManagerPlus() || isActiveTerminal();
      allow write: if false;
    }

    // Vardiya ve mesai (9. ekran)
    match /shiftPlans/{id} {
      allow read: if isStaff() || isActiveTerminal();
      allow write: if false;
    }
    match /timeEntries/{id} {
      allow read: if isManagerPlus() || isActiveTerminal();
      allow write: if false;
    }
    // Saatlik ücret yalnızca işletme sahibine görünür (terminal ve müdür okuyamaz).
    match /staffWages/{id} {
      allow read: if role() == 'owner';
      allow write: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isManagerPlus();
      allow write: if false;
    }

    // syncOps'un tekrar koruması: yalnızca fonksiyonlar kullanır.
    match /processedOps/{opId} {
      allow read, write: if false;
    }

    // Tanımlanmamış her şey kapalı.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
