{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", "test", "scripts", ".git", "*.local"]
    }
  ],
  "emulators": {
    "auth": { "port": 9099, "host": "127.0.0.1" },
    "functions": { "port": 5001, "host": "127.0.0.1" },
    "firestore": { "port": 8080, "host": "127.0.0.1" },
    "ui": { "enabled": false }
  }
}
